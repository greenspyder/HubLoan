    "publicTransmission": "UNCONFIRMED",
    "audio": {
      "playback": [
        {
          "text": "Eu disse que estava com fome. A prova está na barriga!",
          "role": "host",
          "createdAt": 1792767724738,
          "startedAt": 1792767729374,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Duas cobras e uma maçã. Isso vai virar reunião de condomínio.",
          "role": "host",
          "createdAt": 1792767736759,
          "startedAt": 1792767740253,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Elegância na curva, maçã na barriga. Hoje eu vim pronta!",
          "role": "host",
          "createdAt": 1792767748779,
          "startedAt": 1792767751374,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Essa cobra não sabe jogar",
          "role": "comment",
          "createdAt": 1792767759155,
          "startedAt": 1792767762624,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Minha estratégia é deixar a concorrência tão confusa quanto eu.",
          "role": "host",
          "createdAt": 1792767759155,
          "startedAt": 1792767764749,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Que delicadeza! Agora só falta descobrir como segurar sem ter mãos.",
          "role": "host",
          "createdAt": 1792767765180,
          "startedAt": 1792767768750,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "ana · Teste instrumental 1 · TESTE SEM CANTO",
          "role": "music",
          "createdAt": 1792767765180,
          "startedAt": 1792767773250,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Pausa para recuperar a pose. Mentira, eu nunca tive essa pose toda!",
          "role": "host",
          "createdAt": 1792767775630,
          "startedAt": 1792767775874,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "ana · Teste instrumental 3 · TESTE SEM CANTO",
          "role": "music",
          "createdAt": 1792767775630,
          "startedAt": 1792767779999,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Ganhei! Vou fingir que estava tudo no planejamento.",
          "role": "host",
          "createdAt": 1792767788788,
          "startedAt": 1792767792731,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Obrigada pela rosa! Vou guardar longe da curva... por causa dos espinhos.",
          "role": "host",
          "createdAt": 1792767792646,
          "startedAt": 1792767795097,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "ana · Teste instrumental 2 · TESTE SEM CANTO",
          "role": "music",
          "createdAt": 1792767792646,
          "startedAt": 1792767799624,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Eu disse que estava com fome. A prova está na barriga!",
          "role": "host",
          "createdAt": 1792767804792,
          "startedAt": 1792767805641,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Essa curva não combinou comigo. Vou pedir uma segunda opinião.",
          "role": "host",
          "createdAt": 1792767816799,
          "startedAt": 1792767819971,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Mais uma maçã! Minha cintura está virando uma avenida.",
          "role": "host",
          "createdAt": 1792767828800,
          "startedAt": 1792767831090,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Eu disse que estava com fome. A prova está na barriga!",
          "role": "host",
          "createdAt": 1792767840804,
          "startedAt": 1792767841248,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Hoje eu passei vergonha. Amanhã eu passo de fase.",
          "role": "host",
          "createdAt": 1792767852815,
          "startedAt": 1792767855124,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Comprida desse jeito e ainda querem que eu tenha jogo de cintura?",
          "role": "host",
          "createdAt": 1792767864816,
          "startedAt": 1792767867499,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Colheita feita. Agora preciso achar espaço para virar.",
          "role": "host",
          "createdAt": 1792767876818,
          "startedAt": 1792767879375,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Colheita feita. Agora preciso achar espaço para virar.",
          "role": "host",
          "createdAt": 1792767888825,
          "startedAt": 1792767889250,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Perdi a rodada, mas a autoestima continua invicta.",
          "role": "host",
          "createdAt": 1792767900845,
          "startedAt": 1792767903874,
          "source": "INTERNAL_GAME"
        }
      ],
