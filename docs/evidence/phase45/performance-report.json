    "publicTransmission": "UNCONFIRMED",
    "audio": {
      "playback": [
        {
          "text": "Eu disse que estava com fome. A prova está na barriga!",
          "role": "host",
          "createdAt": 1792785736470,
          "startedAt": 1792785738590,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Duas cobras e uma maçã. Isso vai virar reunião de condomínio.",
          "role": "host",
          "createdAt": 1792785748474,
          "startedAt": 1792785750857,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Elegância na curva, maçã na barriga. Hoje eu vim pronta!",
          "role": "host",
          "createdAt": 1792785760477,
          "startedAt": 1792785762590,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Essa cobra não sabe jogar",
          "role": "comment",
          "createdAt": 1792785765586,
          "startedAt": 1792785768990,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Minha estratégia é deixar a concorrência tão confusa quanto eu.",
          "role": "host",
          "createdAt": 1792785765586,
          "startedAt": 1792785771058,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Que delicadeza! Agora só falta descobrir como segurar sem ter mãos.",
          "role": "host",
          "createdAt": 1792785771599,
          "startedAt": 1792785774990,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "ana · Teste instrumental 1 · TESTE SEM CANTO",
          "role": "music",
          "createdAt": 1792785771599,
          "startedAt": 1792785779523,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Pausa para recuperar a pose. Mentira, eu nunca tive essa pose toda!",
          "role": "host",
          "createdAt": 1792785781955,
          "startedAt": 1792785782123,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "ana · Teste instrumental 3 · TESTE SEM CANTO",
          "role": "music",
          "createdAt": 1792785781955,
          "startedAt": 1792785786258,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Mais uma maçã! Minha cintura está virando uma avenida.",
          "role": "host",
          "createdAt": 1792785794489,
          "startedAt": 1792785798257,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Obrigada pela rosa! Vou guardar longe da curva... por causa dos espinhos.",
          "role": "host",
          "createdAt": 1792785798973,
          "startedAt": 1792785801657,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "ana · Teste instrumental 2 · TESTE SEM CANTO",
          "role": "music",
          "createdAt": 1792785798973,
          "startedAt": 1792785806324,
          "source": "SIMULATED_OPERATOR"
        },
        {
          "text": "Colheita feita. Agora preciso achar espaço para virar.",
          "role": "host",
          "createdAt": 1792785812493,
          "startedAt": 1792785812790,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Essa curva não combinou comigo. Vou pedir uma segunda opinião.",
          "role": "host",
          "createdAt": 1792785824498,
          "startedAt": 1792785826458,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Hoje eu passei vergonha. Amanhã eu passo de fase.",
          "role": "host",
          "createdAt": 1792785836498,
          "startedAt": 1792785838190,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Eu disse que estava com fome. A prova está na barriga!",
          "role": "host",
          "createdAt": 1792785850500,
          "startedAt": 1792785851057,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Perdi a rodada, mas a autoestima continua invicta.",
          "role": "host",
          "createdAt": 1792785862505,
          "startedAt": 1792785864524,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Comprida desse jeito e ainda querem que eu tenha jogo de cintura?",
          "role": "host",
          "createdAt": 1792785874505,
          "startedAt": 1792785876790,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Ganhei! Vou fingir que estava tudo no planejamento.",
          "role": "host",
          "createdAt": 1792785886505,
          "startedAt": 1792785888457,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "A concorrência chegou. Vou caprichar no rebolado da curva.",
          "role": "host",
          "createdAt": 1792785898505,
          "startedAt": 1792785900657,
          "source": "INTERNAL_GAME"
        },
        {
          "text": "Essa curva não combinou comigo. Vou pedir uma segunda opinião.",
          "role": "host",
          "createdAt": 1792785910505,
          "startedAt": 1792785911124,
          "source": "INTERNAL_GAME"
        }
      ],
